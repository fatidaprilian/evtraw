# EvtRaw System Properties
# Disable native 5ms touch resampling interpolation in libinput (InputTransport.cpp)
ro.input.resampling=0
# Prevent vendor touch driver from dropping into idle downscaled sampling rates
ro.vendor.display.touch.idle.enable=false
# SurfaceFlinger Render Pacing (Bypass ~8.3ms Triple Buffering queue latency)
debug.sf.latch_unsignaled=1
debug.sf.enable_gl_backpressure=0
